# Copy to backend/.env. The backend reads this file itself; no --env-file needed.

# Google AI Studio key (Gemini chat, vision and embeddings).
GOOGLE_API_KEY=your_gemini_api_key
# Text to image: Cloudflare Workers AI is tried first, Hugging Face second.
# Cloudflare account ID and an API token with Workers AI permission. Leave both unset to
# use Hugging Face only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Hugging Face token with "Make calls to Inference Providers". Required, but may be left
# empty when Cloudflare is set.
HUGGINGFACEHUB_API_TOKEN=your_hf_token
ALLOWED_ORIGINS=http://localhost:5173

# Supabase: Project URL, and a secret key (sb_secret_...) or the legacy service_role key.
# Create the tables first by running supabase/schema.sql in the SQL editor.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_secret_key

# Optional: Gemini models tried in order when one is out of quota.
# GEMINI_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional: lite models for the suggested questions after an upload.
# GEMINI_SUGGEST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
